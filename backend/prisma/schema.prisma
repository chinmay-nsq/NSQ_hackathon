generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core identity ----------

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  LEAD
}

model Employee {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  avatarSeed   String   @default("adventurer")
  createdAt    DateTime @default(now())
  role         Role     @default(EMPLOYEE)

  // Personal progression
  xp         Int    @default(0)
  level      Int    @default(1)
  coins      Int    @default(100)
  reputation Int    @default(0)
  title      String @default("Novice")

  // Work profile — captured once after onboarding, feeds AI task generation
  // (both the employee's own daily solo assignments and a manager's
  // "generate with AI" for a team member). profileCompletedAt gates the
  // mandatory post-onboarding profile step.
  jobRole            String?
  seniority          Seniority?
  skills             String[]   @default([])
  profileCompletedAt DateTime?

  // Set once, the first time this employee's welcome assignment is generated
  // (right after they complete their profile) — guards it from ever being
  // generated a second time, alongside their normal daily quiz.
  welcomeQuestGeneratedAt DateTime?

  // Set once a "finish your profile" stall nudge has been sent, so it's
  // only ever sent once per employee, not on every subsequent login.
  onboardingNudgeSentAt DateTime?

  // True once the guided spotlight tour has been completed OR skipped —
  // persisted server-side (not just localStorage) so it follows the
  // employee across browsers/devices and never re-triggers once done.
  onboardingTourDone Boolean @default(false)

  teamId String?
  team   Team?  @relation("TeamMember", fields: [teamId], references: [id])

  // Team(s) this employee manages, if role is MANAGER or ADMIN.
  managedTeams Team[] @relation("TeamManager")

  companion         Companion?
  assignmentProgress AssignmentProgress[]
  purchases         Purchase[]
  reflections       Reflection[]

  createdAssignments  Assignment[]         @relation("AssignmentCreator")
  assignedAssignments Assignment[]         @relation("AssignmentAssigner")
  approvedProgress   AssignmentProgress[] @relation("ProgressApprover")
  approvedPurchases  Purchase[]          @relation("PurchaseApprover")
  taskComments       TaskComment[]
  taskActivity       TaskActivityLog[]

  listingsSelling Listing[] @relation("ListingSeller")
  listingsBought  Listing[] @relation("ListingBuyer")

  notifications          Notification[] @relation("NotificationRecipient")
  triggeredNotifications Notification[] @relation("NotificationActor")

  standupMessages StandupMessage[] @relation("StandupAuthor")
}

model Companion {
  id         String   @id @default(cuid())
  employeeId String   @unique
  employee   Employee @relation(fields: [employeeId], references: [id])

  species        String // michael, jim, pam, dwight, stanley
  name           String    @unique
  bondLevel      Int       @default(1)
  bondXp         Int       @default(0)
  lastDialogueAt DateTime?
  createdAt      DateTime  @default(now())

  memories     CompanionMemory[]
  chatMessages ChatMessage[]
}

// Rolling short-term memory the AI companion draws on so dialogue
// references real recent events instead of being stateless each call.
model CompanionMemory {
  id          String    @id @default(cuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id])

  // e.g. "completed_assignment", "leveled_up", "team_milestone"
  eventType String
  summary   String   @db.Text
  createdAt DateTime @default(now())
}

enum ChatRole {
  USER
  COMPANION
}

// A real, persisted two-way conversation with the companion — distinct from
// CompanionMemory (a rolling summary log used for prompt context) and from
// the one-off generated dialogue lines shown on the dashboard. Scoped to the
// companion, not the employee, since a companion only ever belongs to one
// employee anyway and this keeps the relation symmetric with memories.
model ChatMessage {
  id          String   @id @default(cuid())
  companionId String
  companion   Companion @relation(fields: [companionId], references: [id])

  role    ChatRole
  content String   @db.Text

  createdAt DateTime @default(now())

  @@index([companionId, createdAt])
}

// ---------- Teams ----------

model Team {
  id         String @id @default(cuid())
  name       String @unique // e.g. "Scranton Engineering"
  department String // e.g. "Engineering"
  emblem     String @default("building")

  level      Int @default(1)
  reputation Int @default(0)

  mascotKind  String @default("stapler")
  mascotName  String @default("Mascot")
  mascotLevel Int    @default(1)

  knowledge Int @default(0)
  gold      Int @default(0)
  influence Int @default(0)
  materials Int @default(0)

  // The manager (or admin) who leads this team and approves its members' tasks.
  managerId String?
  manager   Employee? @relation("TeamManager", fields: [managerId], references: [id])

  // Shareable signup code — anyone who registers with ?invite=<inviteCode>
  // auto-joins this team. Unique per team, generated on creation.
  inviteCode String @unique @default(cuid())

  members       Employee[]            @relation("TeamMember")
  assignments    Assignment[]           @relation("AssignmentTeam")
  contributions CompanyContribution[]
  sprints       Sprint[]
  standup       StandupMessage[]      @relation("TeamStandup")
  createdAt     DateTime              @default(now())
}

// A time-boxed iteration (Azure DevOps-style) that a team's tasks can be
// planned into. Scoped to one team — each team runs its own sprints.
// Whether a sprint is "current" is derived from startDate/endDate against
// today, never a separate hand-maintained status field.
model Sprint {
  id        String   @id @default(cuid())
  teamId   String
  team     Team    @relation(fields: [teamId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  assignments Assignment[]

  @@index([teamId, startDate])
}

// ---------- Company ----------

model Company {
  id        String   @id @default(cuid())
  name      String   @default("The Company")
  createdAt DateTime @default(now())

  projects CompanyProject[]
}

model CompanyProject {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String // e.g. "The Training Center"
  description String
  unlocked    Boolean @default(false)

  knowledgeNeeded Int @default(0)
  goldNeeded      Int @default(0)
  influenceNeeded Int @default(0)
  materialsNeeded Int @default(0)

  knowledgeContributed Int @default(0)
  goldContributed      Int @default(0)
  influenceContributed Int @default(0)
  materialsContributed Int @default(0)

  contributions CompanyContribution[]
  createdAt     DateTime              @default(now())
}

model CompanyContribution {
  id        String         @id @default(cuid())
  projectId String
  project   CompanyProject @relation(fields: [projectId], references: [id])
  teamId   String
  team     Team          @relation(fields: [teamId], references: [id])

  resourceType String // knowledge | gold | influence | materials
  amount       Int
  createdAt    DateTime @default(now())
}

// ---------- Assignments ----------

enum AssignmentType {
  SOLO
  TEAM
  CROSS_TEAM
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// Where a card sits on the Kanban board. Deliberately separate from
/// AssignmentStatus (which is lifecycle: active/completed/expired) and from
/// the approval fields on AssignmentProgress, so a card can be dragged
/// freely between columns without touching rewards. The approval actions
/// still write their result here, so in normal use the two agree.
enum BoardStatus {
  TODO
  IN_REVIEW
  NEEDS_REWORK
  DONE
}

model Assignment {
  id          String          @id @default(cuid())
  type        AssignmentType
  title       String
  description String          @db.Text
  status      AssignmentStatus @default(ACTIVE)

  // Work-item kind for the Kanban board — orthogonal to `type` (which is
  // about WHO it's for: solo/team/cross-team). A manager picks this when
  // creating a task, the same way Azure DevOps has Task/User Story/Bug.
  workItemType WorkItemType @default(TASK)

  // Kanban column, set by dragging a card. See BoardStatus above for why
  // this is stored rather than derived from the approval flow.
  boardStatus BoardStatus @default(TODO)

  xpReward        Int @default(0)
  coinReward      Int @default(0)
  knowledgeReward Int @default(0)
  goldReward      Int @default(0)
  influenceReward Int @default(0)
  materialsReward Int @default(0)

  // SOLO: assigned to one employee. TEAM: scoped to one team.
  // CROSS_TEAM: open to multiple teams, tracked via participants.
  teamId String?
  team   Team?  @relation("AssignmentTeam", fields: [teamId], references: [id])

  // Which sprint this task is planned into — null means it's in the
  // backlog (unplanned). Only ever set on manager-assigned tasks; a manager
  // picks the sprint (default: whichever one is currently active) when
  // creating one.
  sprintId String?
  sprint   Sprint? @relation(fields: [sprintId], references: [id])

  createdById String?
  createdBy   Employee? @relation("AssignmentCreator", fields: [createdById], references: [id])

  // Set only for SOLO assignments a manager/admin assigned to someone else —
  // distinguishes "my manager gave me this" from an employee's own
  // self-authored task, both of which otherwise look identical (aiGenerated: false).
  assignedById String?
  assignedBy   Employee? @relation("AssignmentAssigner", fields: [assignedById], references: [id])

  aiGenerated Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  // Set only on the self-serve daily quiz, to a "YYYY-MM-DD" date string —
  // paired with the unique index below, this makes it impossible for two
  // concurrent generate requests (e.g. two tabs, or a fast double-click) to
  // ever create two quizzes for the same employee on the same day: the
  // second insert fails a real DB constraint instead of racing a
  // check-then-create in application code.
  dailyQuizDate String?

  // Set only for the self-serve daily solo assignment, which is a 5-question
  // skill quiz rather than a plain text task. Each entry: { question,
  // options: string[], string: string, number: string } — the correct
  // option's index is never stored directly; it's derivable by reducing
  // `number` to a single digit and indexing into `string` at that position.
  quiz Json?

  progress AssignmentProgress[]
  comments TaskComment[]
  activity TaskActivityLog[]
  standup  StandupMessage[]  @relation("StandupTask")

  @@unique([createdById, dailyQuizDate])
}

enum WorkItemType {
  TASK
  STORY
  BUG
}

enum ApprovalStatus {
  NONE // not yet submitted for completion
  PENDING // submitted, awaiting manager/admin approval
  APPROVED // approved — rewards have been credited
  REJECTED // manager/admin sent it back; not credited
}

model AssignmentProgress {
  id          String    @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id])

  completed   Boolean   @default(false)
  submission  String?   @db.Text
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // Set only when completing a quiz-type solo assignment — the option index
  // the employee picked per question, and how many were graded correct
  // (client-reported; coins are credited 5 per correct answer).
  quizAnswers      Json?
  quizCorrectCount Int?

  // Approval workflow — AI-generated assignments skip straight to APPROVED
  // (crediting on completion, same as before); manually-created assignments
  // go PENDING until a manager/admin approves or rejects them.
  approval      ApprovalStatus @default(NONE)
  approvedById  String?
  approvedBy    Employee?      @relation("ProgressApprover", fields: [approvedById], references: [id])
  approvedAt    DateTime?
  rejectionNote String?        @db.Text

  @@unique([assignmentId, employeeId])
}

// Real discussion on a task, shown in its enlarged detail view.
model TaskComment {
  id          String    @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  authorId    String
  author      Employee  @relation(fields: [authorId], references: [id])
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  @@index([assignmentId, createdAt])
}

enum TaskActivityType {
  CREATED
  ASSIGNED
  SUBMITTED
  APPROVED
  REJECTED
  COMMENTED
  // Dragged between Kanban columns. Distinct from SUBMITTED/APPROVED, which
  // are approval-flow actions that happen to also move the card.
  MOVED
}

// Every real movement of a task — what feeds both the task detail view's
// history and the Standup page's "who did what" feed. Written alongside
// the actual state change (never backfilled/inferred), so it's always a
// true record of what happened and when.
model TaskActivityLog {
  id          String            @id @default(cuid())
  assignmentId String
  assignment   Assignment         @relation(fields: [assignmentId], references: [id])
  actorId     String
  actor       Employee          @relation(fields: [actorId], references: [id])
  type        TaskActivityType
  detail      String
  createdAt   DateTime          @default(now())

  @@index([assignmentId, createdAt])
  @@index([actorId, createdAt])
}

/// Whether a standup line was typed by a person or generated by a real
/// task movement. Events are written at the moment the change happens, so
/// the room is a true record rather than a recap.
enum StandupMessageKind {
  CHAT
  EVENT
}

// The team standup room — one per team. Holds both what people type and
// the system lines posted when a task actually moves, in one ordered
// timeline, so the conversation and the work sit in the same place.
//
// EVENT rows store their sentence already rendered: the room is a log of
// what was true when it happened, so a task later being renamed must not
// silently rewrite history. `assignmentId` is kept alongside so the UI can
// still link through to the task as it is now.
model StandupMessage {
  id      String @id @default(cuid())
  teamId String
  team   Team  @relation("TeamStandup", fields: [teamId], references: [id])

  // Set for both kinds: an EVENT still has the person who caused it.
  authorId String
  author   Employee @relation("StandupAuthor", fields: [authorId], references: [id])

  kind StandupMessageKind
  body String             @db.Text

  assignmentId String?
  assignment   Assignment? @relation("StandupTask", fields: [assignmentId], references: [id])

  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

model Reflection {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  content    String   @db.Text
  createdAt  DateTime @default(now())
}

// ---------- Marketplace ----------

model MarketplaceItem {
  id          String  @id @default(cuid())
  name        String
  description String
  cost        Int
  icon        String  @default("gift")
  active      Boolean @default(true)

  purchases Purchase[]
}

model Purchase {
  id         String          @id @default(cuid())
  employeeId String
  employee   Employee        @relation(fields: [employeeId], references: [id])
  itemId     String
  item       MarketplaceItem @relation(fields: [itemId], references: [id])

  createdAt DateTime @default(now())

  // Reward-claim approval: coins are deducted (reserved) the moment an
  // employee orders a reward, but the claim itself waits on a manager.
  // PENDING = "Ordered" (shown to the employee), APPROVED = "Claimed",
  // REJECTED = coins refunded, order voided.
  approval     ApprovalStatus @default(PENDING)
  approvedById String?
  approvedBy   Employee?      @relation("PurchaseApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  listings Listing[]
}

enum ListingStatus {
  ACTIVE
  SOLD
  CANCELLED
}

// The Trading Post: an employee re-lists something they already own
// (a Purchase) for other employees to buy with coins, at up to what they
// originally paid — never more. Ownership of the underlying Purchase
// transfers to the buyer on sale, so a bought item can be re-listed again
// later by its new owner.
model Listing {
  id     String @id @default(cuid())
  status ListingStatus @default(ACTIVE)

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])

  sellerId String
  seller   Employee @relation("ListingSeller", fields: [sellerId], references: [id])

  buyerId String?
  buyer   Employee? @relation("ListingBuyer", fields: [buyerId], references: [id])

  askingPrice Int

  createdAt DateTime  @default(now())
  soldAt    DateTime?
}

// ---------- Notifications ----------

enum NotificationType {
  REWARD_CLAIMED // an employee redeemed a marketplace reward — their manager is notified
  ONBOARDING_STALLED // an employee picked a companion but never finished their profile — nudge sent to themself
  REWARD_APPROVED // a manager approved an employee's ordered reward — the employee is notified it's claimed
  REWARD_REJECTED // a manager rejected an employee's ordered reward (coins refunded) — the employee is notified
}

// A lightweight in-app notification. recipientId is who sees it (e.g. a
// manager); actorId is who triggered it (e.g. the employee who redeemed a
// reward) — kept separate from recipient so the UI can show "who did this"
// without re-deriving it from the event type.
model Notification {
  id     String            @id @default(cuid())
  type   NotificationType
  title  String
  body   String
  read   Boolean           @default(false)

  recipientId String
  recipient   Employee @relation("NotificationRecipient", fields: [recipientId], references: [id])

  actorId String?
  actor   Employee? @relation("NotificationActor", fields: [actorId], references: [id])

  createdAt DateTime @default(now())

  @@index([recipientId, read])
}
